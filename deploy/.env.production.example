# Alert-Worker production environment (src/config/config.ts).
# Copy to deploy/.env. Blank values fall back to defaults; any invalid value stops startup with ConfigError.
# Apply the MySQL migrations (migrations/) before starting.

# ---- Required -------------------------------------------------------------
# Redis endpoint (default redis://localhost:6401 is never right in production).
# URL-encode reserved characters in the password.
REDIS_URL=redis://:replace-with-url-encoded-password@redis.internal:6379/0
# Required: the worker refuses to start without it.
DATABASE_URL=mysql://evacs:replace-with-url-encoded-password@mysql.internal:3306/evacs

# ---- Instance identity ----------------------------------------------------
# Must be unique per running instance. Default: HOSTNAME, then os.hostname().
CONSUMER_NAME=alert-worker-1

# ---- Health ---------------------------------------------------------------
# /readyz is served on this port (0-65535).
HEALTH_PORT=18083

# ---- Logging --------------------------------------------------------------
# info | debug
LOG_LEVEL=info

# ---- Streams / keys (must match Emergency-Worker and Control API Server) --
ALERT_STREAM=stream:alert:event
DLQ_STREAM=stream:alert-worker:dlq
CONSUMER_GROUP=alert-worker
# Control API Server alerted-vehicle Set key; exactly one %s (emergency ID).
EVACS_ALERT_KEY_PATTERN=evacs:emergency:%s:alerted

# ---- Consumer tuning (defaults shown) -------------------------------------
READ_COUNT=10
BLOCK_MS=1000
PENDING_MIN_IDLE_MS=30000
MAX_DELIVERIES=5
EXPIRY_SWEEP_MS=1000
DEDUP_TTL_MS=10000
DLQ_MAXLEN=10000
SHUTDOWN_DRAIN_TIMEOUT_MS=5000
